{
  "name": "ai-pdlc-learning-stage-4-code",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "allowScripts": {
    "esbuild": true
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4173 --strictPort",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4174 --strictPort",
    "typecheck": "tsc --noEmit",
    "test:runtime": "tsx --test test/calculator.test.ts",
    "test:contract": "tsx --test test/repository-contract.test.ts",
    "test": "tsx --test test/*.test.ts",
    "validate:links": "tsx scripts/check-local-links.ts",
    "privacy:scan": "tsx scripts/privacy-scan.ts",
    "check:code": "npm run typecheck && npm test && npm run validate:links && npm run privacy:scan && npm run build",
    "check:store": "tsx scripts/check-openspec-store.ts",
    "check": "npm run check:code && npm run check:store",
    "prepare": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "@fission-ai/openspec": "2.1.1",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
